# TrustVault environment configuration
# Replace placeholders with your own values. Never commit real secrets.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string for local development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# At least 32 characters; generate a private random value
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Separate test database only. Never point this at production data.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/TEST_DATABASE
